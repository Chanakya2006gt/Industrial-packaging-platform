# ==============================================================================
# PrintFast Zambia Limited (PZL) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure appropriate values for your deployment.
# NEVER commit the actual .env file with secrets into source control.
# Note: Company details (phone, currency, address, notices) are managed
# dynamically via the Admin Console and stored in the database.
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true

# Supabase Cloud Platform (PostgreSQL, Auth, and Storage)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Security & Session Configuration
# Generate a cryptographically strong 64-character secret using: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_random_64_byte_cryptographic_secret_key_in_production
SESSION_MAX_AGE_MS=28800000
COOKIE_SECURE=false # Set to true in production behind HTTPS/TLS
COOKIE_SAME_SITE=strict

# Initial SuperAdmin Seed Account (used only during initial database bootstrap)
SEED_ADMIN_EMAIL=admin@printfastzambia.com
SEED_ADMIN_PASSWORD=PZL_Admin2026!Secure
SEED_ADMIN_NAME=PrintFast Lusaka Admin

# ------------------------------------------------------------------------------
# 4. Database Configuration (SQLite WAL Mode)
# ------------------------------------------------------------------------------
DATABASE_PATH=./server/database/printfast.db

# ------------------------------------------------------------------------------
# 5. Storage Driver & Cloud Object Storage (Customer Dielines & Catalog Images)
# ------------------------------------------------------------------------------
# Active storage driver: 'local' (Default for Dev/Testing), 'r2' (Cloudflare R2), or 's3' (AWS S3)
STORAGE_PROVIDER=local

# --- Local Disk Storage (Active when STORAGE_PROVIDER=local) ---
UPLOAD_DIR=./server/storage/uploads
UPLOAD_MAX_SIZE_BYTES=15728640 # 15MB maximum per vector file

# --- Cloudflare R2 Cloud Object Storage (Recommended for Production - $0 Egress) ---
# Active when STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=printfast-production-assets
R2_PUBLIC_DOMAIN=https://cdn.printfastzambia.com # Public edge CDN domain for catalog images
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# --- AWS S3 Cloud Object Storage (Alternative Production Cloud) ---
# Active when STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=af-south-1 # Cape Town (or eu-west-1 / us-east-1)
AWS_S3_BUCKET_NAME=printfast-production-assets

# Pre-signed Secure Download URL Expiry for Private Customer Artwork (Seconds)
SIGNED_URL_EXPIRY_SECONDS=900 # 15 minutes

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Abuse Prevention
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_RFQ_MAX=10
RATE_LIMIT_RFQ_WINDOW_MS=3600000   # 1 hour
