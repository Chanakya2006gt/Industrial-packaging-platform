# ==============================================================================
# Apex Packaging & Converting — Backend & Worker Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this file to backend/.env (e.g. cp .env.example .env)
# 2. In your Supabase Dashboard -> Project Settings -> Data API / API Keys:
#    - Copy "Project URL" (or "API URL") -> SUPABASE_URL
#    - Copy "Publishable key" (or "anon public") -> SUPABASE_ANON_KEY
#    - Copy "Secret key" (or "service_role secret") -> SUPABASE_SERVICE_ROLE_KEY
#
# Note: You do NOT need Direct Connection String (postgresql://...) or Prisma.
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=5001

# Supabase Cloud Database & Storage Connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Background Worker Sweep Interval (Milliseconds, Default: 15 mins)
WORKER_INTERVAL_MS=900000
